<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>3f29941e-2e9e-4a9b-865b-0b44866141e2</UserSecretsId>
    <!-- Surfaced as the MCP server version (serverInfo.version) and in /.well-known/mcp.json.
         Bump on MCP surface changes so clients that cache connector metadata (e.g. ChatGPT)
         re-read tools and UI resources instead of serving a stale template. -->
    <Version>1.7.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <DefineConstants>$(DefineConstants);SAMPLE_DATA</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="OpenIddict.AspNetCore" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- Self-contained MCP Apps UIs: a rich recipe view, a read-only meal plan, and a reusable data renderer. -->
    <EmbeddedResource Include="Recipes\RecipeUiApp.html" />
    <EmbeddedResource Include="MealPlanner\MealPlannerUiApp.html" />
    <EmbeddedResource Include="Mcp\DataUiApp.html" />
    <EmbeddedResource Include="MealPlanner\MealPlanUiApp.html" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kotlet.Application\Kotlet.Application.csproj" />
    <ProjectReference Include="..\Kotlet.Infrastructure\Kotlet.Infrastructure.csproj" />
    <!-- Sample-data fixture for local SQLite runs, gated behind Database:SeedSampleData.
         Excluded from Release so test fixtures never ship in a production artifact; the
         seeding call is compiled out with it via the SAMPLE_DATA symbol below. -->
    <ProjectReference Include="..\Kotlet.TestData\Kotlet.TestData.csproj"
                      Condition="'$(Configuration)' != 'Release'" />
    <ProjectReference Include="..\..\aspire\Kotlet.ServiceDefaults\Kotlet.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
